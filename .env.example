# Copy to .env and fill in. Never commit .env.

# --- Neo4j AuraDB (console.neo4j.io → your instance → connection details) ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=<instance-id>
NEO4J_PASSWORD=change-me

# --- LLM provider ---
# bedrock | groq. Defaults to bedrock when BEDROCK_API_KEY is set, else groq.
# LLM_PROVIDER=bedrock

# Amazon Bedrock (OpenAI-compatible endpoint, paid from AWS credits)
# BEDROCK_API_KEY=
# BEDROCK_REGION=us-west-2
# BEDROCK_MODEL=openai.gpt-oss-120b-1:0

# Groq (free tier, ~8,000 tokens/min per key). Comma-separated, one key per account.
GROQ_API_KEYS=
# GROQ_MODEL=openai/gpt-oss-120b
